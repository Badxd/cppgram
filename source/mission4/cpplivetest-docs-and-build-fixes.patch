+#!/usr/bin/env bash
+# Builds the live-test bot and runs its offline unit tests.
+#   CPPGRAM_SOURCE_DIR=/path/to/cppgram ./build.sh        build the unmodified library from source
+#   CPPGRAM_PREBUILT_DIR=/path/to/lib \
+#   CPPGRAM_PREBUILT_INCLUDE_DIR=/path/to/cppgram/include ./build.sh   link an already built libcppgram.a
+# Optional: BUILD_DIR (default ./build). Compiler: set CC and CXX in the environment as usual.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+build="${BUILD_DIR:-$here/build}"
+args=(-DCMAKE_BUILD_TYPE=Release)
+[ -n "${CPPGRAM_SOURCE_DIR:-}" ] && args+=(-DCPPGRAM_SOURCE_DIR="$CPPGRAM_SOURCE_DIR")
+[ -n "${CPPGRAM_PREBUILT_DIR:-}" ] && args+=(-DCPPGRAM_PREBUILT_DIR="$CPPGRAM_PREBUILT_DIR")
+[ -n "${CPPGRAM_PREBUILT_INCLUDE_DIR:-}" ] && args+=(-DCPPGRAM_PREBUILT_INCLUDE_DIR="$CPPGRAM_PREBUILT_INCLUDE_DIR")
+cmake -S "$here" -B "$build" "${args[@]}"
+cmake --build "$build" -j"$(nproc)"
+ctest --test-dir "$build" --output-on-failure
+echo "built: $build/cppgram_live_test_bot"
