# Copy to .env and fill in. Never commit .env. Values below are placeholders only.
# The library reads credentials from ClientOptions; the example programs and
# cppgram_live_check read these variables.

TG_API_ID=000000
TG_API_HASH=replace-with-api-hash
TG_BOT_TOKEN=000000000:replace-with-bot-token
# DC order for the live check, comma separated (default 2,1,3,4,5)
TG_DCS=2,1,3,4,5
# 1 = stage logs on (default), 0 = off
TG_DEBUG=1

# Session storage (used by your application; cppgram takes the path from ClientOptions)
CPPGRAM_SESSION_DIR=/var/lib/cppgram
CPPGRAM_SESSION_NAME=service
